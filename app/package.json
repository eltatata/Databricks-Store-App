{
  "name": "store-app",
  "version": "1.0.0",
  "main": "dist/server.js",
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "start": "NODE_ENV=production node --env-file-if-exists=./.env ./dist/server.js",
    "dev": "tsx watch --tsconfig ./tsconfig.server.json --env-file-if-exists=./.env ./server/server.ts",
    "build:client": "tsc -b tsconfig.client.json && vite build --config client/vite.config.ts",
    "build:server": "tsc -b tsconfig.server.json && tsdown -c tsdown.server.config.ts",
    "build": "pnpm run build:server && pnpm run build:client",
    "typecheck": "tsc -b tsconfig.server.json && tsc -b tsconfig.client.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ast-grep": "appkit lint",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:smoke": "playwright test",
    "clean": "rm -rf client/dist dist build node_modules",
    "prebuild": "pnpm run sync && appkit generate-types --wait",
    "predev": "pnpm run sync && pnpm run typegen",
    "sync": "appkit plugin sync --write --silent",
    "typegen": "appkit generate-types",
    "setup": "appkit setup --write",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "geo:brazil": "tsx scripts/build-brazil-states.ts"
  },
  "keywords": [],
  "author": "",
  "license": "Unlicensed",
  "description": "Olist store: KPI dashboard, product CRUD and AI assistant",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@databricks/appkit": "0.84.0",
    "@databricks/appkit-ui": "0.84.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@number-flow/react": "^0.6.2",
    "@tanstack/react-query": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "2.1.1",
    "d3-array": "^3.2.4",
    "d3-geo": "^3.1.2",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "express": "4.22.2",
    "lucide-react": "0.546.0",
    "motion": "^14.0.0",
    "pg": "8.18.0",
    "radix-ui": "^1.7.0",
    "react": "19.2.4",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.89.0",
    "react-router": "7.18.0",
    "sonner": "^2.0.8",
    "swagger-ui-express": "^5.0.1",
    "tailwind-merge": "3.3.1",
    "tw-animate-css": "1.4.0",
    "zod": "4.3.6",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@ast-grep/napi": "0.37.0",
    "@eslint/js": "9.39.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/d3-array": "^3.2.2",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/express": "5.0.5",
    "@types/geojson": "^7946.0.16",
    "@types/node": "24.6.0",
    "@types/pg": "^8.15.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitejs/plugin-react": "5.0.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "jsdom": "^30.1.2",
    "prettier": "3.6.2",
    "supertest": "^7.3.1",
    "tailwindcss": "4.3.5",
    "tsdown": "0.20.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vite": "npm:rolldown-vite@7.1.14",
    "vitest": "4.1.9"
  },
  "optionalDependencies": {
    "@ast-grep/napi-linux-x64-gnu": "0.37.0"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.1.14",
    "@opentelemetry/core": "2.8.0",
    "systeminformation": "5.31.7",
    "fast-uri": "3.1.0",
    "socks": "2.8.7",
    "bare-path": "3.1.1",
    "bare-url": "2.5.2"
  }
}
